{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibAdmin",
  "version": "0.2.0",
  "identifier": "com.libadmin.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LibAdmin 书库",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
